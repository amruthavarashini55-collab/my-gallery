rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'amrutha.varashini55@gmail.com';
    }
    match /drawings/{drawingId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.email == 'amrutha.varashini55@gmail.com';
      allow update: if (request.auth != null && request.auth.token.email == 'amrutha.varashini55@gmail.com')
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
                    
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null && request.auth.token.email == 'amrutha.varashini55@gmail.com';
      }
    }
  }
}
